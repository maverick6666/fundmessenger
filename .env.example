# FundMessenger 환경변수 예시
# 이 파일을 .env 로 복사해 값을 채운다. 실제 값은 절대 커밋하지 않는다.
# 주의: backend/build.gradle 은 '=' 뒤 전부를 값으로 읽는다. 주석은 반드시 줄을 따로 써야 한다.

# ── 필수 ─────────────────────────────────────────────
# development 일 때만 /api/auth/dev-login 과 시드 데이터가 켜진다. 운영은 production.
ENVIRONMENT=development
DATABASE_URL=jdbc:postgresql://localhost:5434/fundmessenger?charSet=UTF-8
DB_USERNAME=funduser
DB_PASSWORD=localdev-only
# JWT 서명 키. 32바이트 이상 임의 문자열, 운영에서는 반드시 새로 만든다.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
FRONTEND_URL=http://localhost:3000

# ── 소셜 로그인 (쓰지 않으면 비워 두고 dev-login 사용) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT=http://localhost:8080/api/auth/oauth2/callback/google
OAUTH_KAKAO_REDIRECT=http://localhost:8080/api/auth/oauth2/callback/kakao
OAUTH_NAVER_REDIRECT=http://localhost:8080/api/auth/oauth2/callback/naver

# ── 선택: 비워 두면 그 기능만 꺼진다 ─────────────────
# Redis 가 없으면 랭킹 캐시를 DB 스냅샷으로 대신한다.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# 비우면 UPLOAD_DIR 에 로컬로 저장한다.
GCS_BUCKET_NAME=
UPLOAD_DIR=uploads
# 웹 푸시
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:you@example.com
# AI 문서 분석 · 뉴스 브리핑 · 댓글봇 (키 여러 개는 쉼표로 구분)
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash-lite
CEREBRAS_API_KEYS=
CEREBRAS_MODEL=qwen-3-235b-a22b-instruct-2507
# 한국투자증권 시세
KIS_APP_KEY=
KIS_APP_SECRET=
# 뉴스 검색
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
MARKETAUX_API_KEY=
TAVILY_API_KEYS=
SERPAPI_API_KEYS=
NEWS_PIPELINE_ENABLED=false

# ── 프론트엔드 (frontend/.env 에 따로 둔다) ─────────
# VITE_API_URL=http://localhost:8080/api
